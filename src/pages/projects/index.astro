---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SiteLayout
  title="Projects"
  description="Software, machine learning, robotics, hackathon, and competition projects by Tarit."
>
  <main class="w-full max-w-none p-0">
    <section class="mx-auto w-full max-w-6xl p-6">
      <header class="py-10 text-center">
        <h1 class="text-5xl font-bold tracking-tight">Projects</h1>
        <p class="mx-auto max-w-2xl text-gray-700">
          Software, machine learning, robotics, hackathon, and competition work.
        </p>
      </header>
      <div class="content-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>
</SiteLayout>
