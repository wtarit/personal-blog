---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import heroImage from "../../assets/images/Tarit_image.jpeg";
---

<section
  class="grid items-center gap-10 p-6 md:grid-cols-[minmax(0,1fr)_18rem]"
>
  <div class="max-w-3xl">
    <h1 class="max-w-3xl text-5xl! font-bold tracking-tight">Hi, I'm Tarit.</h1>
    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-gray-700">
      I'm a UBC Computer Science student with experience building production
      backend services and running self-hosted services in my homelab.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/Tarit-Resume.pdf"
        target="_blank"
        rel="noreferrer"
        class="inline-flex h-11 items-center justify-center rounded-md bg-black px-5 text-sm font-bold text-white! transition-colors hover:bg-gray-800"
      >
        View résumé
      </a>
      <a
        href="#projects"
        class="inline-flex h-11 items-center justify-center rounded-md border border-gray-300 bg-white px-5 text-sm font-bold text-gray-900! transition-colors hover:border-gray-400 hover:bg-gray-50"
      >
        Selected projects
      </a>
      <div class="flex shrink-0 items-center gap-3">
        <a
          href="mailto:tarit@wtarit.me"
          class="inline-flex h-11 items-center justify-center gap-2 px-2 text-sm font-bold text-gray-700! hover:text-black!"
        >
          <Icon name="lucide:mail" class="h-5 w-5" aria-hidden="true" />
          Email
        </a>
        <a
          href="https://github.com/wtarit"
          target="_blank"
          rel="noreferrer"
          class="inline-flex h-11 items-center justify-center gap-2 px-2 text-sm font-bold text-gray-700! hover:text-black!"
        >
          <Icon name="simple-icons:github" class="h-5 w-5" />
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/wtarit"
          target="_blank"
          rel="noreferrer"
          class="inline-flex h-11 items-center justify-center gap-2 px-2 text-sm font-bold text-gray-700! hover:text-black!"
        >
          <Icon name="simple-icons:linkedin" class="h-5 w-5" />
          LinkedIn
        </a>
      </div>
    </div>
  </div>

  <div class="order-first mx-auto w-full max-w-56 md:order-last md:max-w-none">
    <Image
      class="aspect-square w-full rounded-3xl object-cover shadow-lg"
      src={heroImage}
      alt="Tarit's portrait"
      inferSize
    />
  </div>
</section>
