---
interface Extracurricular {
  title: string;
  organization: string;
  duration: string;
  description: string;
}

const technicalExtracurriculars: Extracurricular[] = [
  {
    title: "Software Developer",
    organization: "UBC Uncrewed Aircraft Systems Engineering Design Team",
    duration: "September 2023 - August 2024",
    description:
      "Built ground-communication APIs for ArduPilot using Pymavlink and object detection/localization pipelines using YOLOv8 and OpenCV.",
  },
];
---

<div class="p-6">
  <h2 class="scroll-m-20 py-6 text-center text-4xl font-bold tracking-tight">
    Technical Extracurriculars
  </h2>
  <div class="space-y-6">
    {technicalExtracurriculars.map((extracurricular) => (
      <div class="rounded-lg border bg-white shadow-sm">
        <div class="p-6 pb-4">
          <h3 class="text-2xl font-semibold leading-none tracking-tight">
            {extracurricular.title}
          </h3>
          <div class="flex justify-between flex-col md:flex-row text-sm text-gray-600 my-2">
            <div>{extracurricular.organization}</div>
            <div>{extracurricular.duration}</div>
          </div>
          <p class="m-0">{extracurricular.description}</p>
        </div>
      </div>
    ))}
  </div>
</div>
