---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "../FormattedDate.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section aria-labelledby="recent-posts-heading" class="p-6">
  <div class="flex items-center justify-between gap-4 py-6">
    <h2
      id="recent-posts-heading"
      class="m-0 text-4xl font-bold tracking-tight"
    >
      Latest Blog Posts
    </h2>
    <a class="shrink-0 text-sm font-bold no-underline" href="/blog">
      View all posts
    </a>
  </div>

  <ul class="content-grid m-0 list-none p-0">
    {
      posts.map((post) => (
        <li>
          <a
            class="content-card group"
            href={`/blog/${post.id}/`}
          >
            {post.data.heroImage && (
              <Image
                src={post.data.heroImage}
                alt=""
                class="content-card-image"
                width={720}
                height={405}
              />
            )}
            <div class="content-card-body">
              <p class="m-0 text-sm text-gray-600">
                <FormattedDate date={post.data.pubDate} />
              </p>
              <h3 class="content-card-title mt-2 transition-colors group-hover:text-(--accent)">
                {post.data.title}
              </h3>
              <p class="content-card-description">
                {post.data.description}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>
