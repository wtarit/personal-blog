---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "../FormattedDate.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section aria-labelledby="recent-posts-heading" class="p-6">
  <div class="flex items-center justify-between gap-4 py-6">
    <h2
      id="recent-posts-heading"
      class="m-0 text-4xl font-bold tracking-tight"
    >
      Latest Blog Posts
    </h2>
    <a class="shrink-0 text-sm font-bold no-underline" href="/blog">
      View all posts
    </a>
  </div>

  <ul
    class="-mx-6 m-0 flex list-none gap-4 overflow-x-auto px-6 pb-2 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0 md:pb-0"
  >
    {
      posts.map((post) => (
        <li class="w-[82vw] max-w-80 shrink-0 md:w-auto md:max-w-none">
          <a
            class="group block h-full overflow-hidden rounded-lg border bg-white text-inherit no-underline shadow-sm transition-shadow hover:shadow-md"
            href={`/blog/${post.id}/`}
          >
            {post.data.heroImage && (
              <Image
                src={post.data.heroImage}
                alt=""
                class="aspect-video w-full rounded-none object-cover"
                width={720}
                height={405}
              />
            )}
            <div class="p-5">
              <p class="m-0 text-sm text-gray-600">
                <FormattedDate date={post.data.pubDate} />
              </p>
              <h3 class="mt-2 text-xl font-semibold tracking-tight transition-colors group-hover:text-(--accent)">
                {post.data.title}
              </h3>
              <p class="m-0 text-sm leading-relaxed text-gray-700">
                {post.data.description}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>
