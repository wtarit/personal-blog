---
interface WorkExperience {
  title: string;
  company: string;
  duration: string;
  description: string;
}

const workExperiences: WorkExperience[] = [
  {
    title: "Software Engineer Co-op",
    company: "Workstream - Burnaby, BC",
    duration: "July 2026 - December 2026",
    description:
      "Developing Workstream’s HRIS platform using React, TypeScript, and Ruby on Rails.",
  },
  {
    title: "Undergraduate Teaching Assistant - CPSC 310",
    company: "University of British Columbia - Vancouver, BC",
    duration: "September 2025 - June 2026",
    description:
      "Supported 848 students with TypeScript, Express.js APIs, asynchronous programming, debugging, and testing.",
  },
  {
    title: "Software Engineer Co-op",
    company:
      "Agoda Services (subsidiary of Booking Holdings Inc.) - Bangkok, Thailand",
    duration: "May 2025 - August 2025",
    description:
      "Improved Agoda's Cashback platform using C#, SQL, and GraphQL by automating manual reviews, stabilizing integration tests, and load-testing new releases with k6.",
  },
  {
    title: "Software Developer Intern",
    company: "Applicad Public Company Limited - Bangkok, Thailand",
    duration: "June 2024 - August 2024",
    description:
      "Built and deployed a real-time facial-recognition app using Next.js, FastAPI, and ChromaDB, integrated with the company's customer database.",
  },
];
---

<div class="p-6">
  <h2 class="scroll-m-20 py-6 text-center text-4xl font-bold tracking-tight">
    Work Experience
  </h2>
  <div class="space-y-6">
    {
      workExperiences.map((workExperience) => (
        <div class="rounded-lg border bg-white shadow-sm">
          <div class="p-6 pb-4">
            <h3 class="text-2xl font-semibold leading-none tracking-tight">
              {workExperience.title}
            </h3>
            <div class="flex justify-between flex-col md:flex-row text-sm text-gray-600 my-2">
              <div>{workExperience.company}</div>
              <div>{workExperience.duration}</div>
            </div>
            <p class="m-0">{workExperience.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
