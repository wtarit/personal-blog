---
import { getCollection } from "astro:content";
import ProjectCard from "../ProjectCard.astro";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured && !project.data.draft)
  .sort(
    (a, b) =>
      (a.data.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
      (b.data.featuredOrder ?? Number.MAX_SAFE_INTEGER),
  );
---

<section class="p-6" aria-labelledby="selected-projects-heading">
  <div class="flex items-center justify-between gap-4 py-6">
    <h2 id="selected-projects-heading" class="m-0 scroll-m-20 text-4xl font-bold tracking-tight">
      Selected Projects
    </h2>
    <a class="shrink-0 text-sm font-bold no-underline" href="/projects">
      View all projects
    </a>
  </div>
  <div class="content-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
