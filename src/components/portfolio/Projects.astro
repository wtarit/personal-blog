---
import { getCollection } from "astro:content";
import ProjectCard from "../ProjectCard.astro";

const selectedProjectIds = [
  "ubc-discovery",
  "ubc-newcomers-ubc-cic-2026",
  "pipelie-mlh-production-hack-2026",
  "bitrelay-edc-2026",
  "wastewizard",
  "kibo-robot-programming-challenge",
];

const allProjects = await getCollection("projects");
const projectsById = new Map(allProjects.map((project) => [project.id, project]));
const projects = selectedProjectIds
  .map((id) => {
    const project = projectsById.get(id);

    if (!project) {
      throw new Error(`Selected project "${id}" does not exist`);
    }

    return project;
  })
  .filter((project) => !project.data.draft);
---

<section class="p-6" aria-labelledby="selected-projects-heading">
  <div class="flex items-center justify-between gap-4 py-6">
    <h2 id="selected-projects-heading" class="m-0 scroll-m-20 text-4xl font-bold tracking-tight">
      Selected Projects
    </h2>
    <a class="shrink-0 text-sm font-bold no-underline" href="/projects">
      View all projects
    </a>
  </div>
  <div class="content-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
